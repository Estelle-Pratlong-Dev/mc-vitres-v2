# Désactiver l'affichage du contenu des dossiers
Options -Indexes

# Headers de sécurité
<IfModule mod_headers.c>
    # Empêche le chargement dans une iframe (clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Empêche le navigateur de deviner le type MIME
    Header always set X-Content-Type-Options "nosniff"

    # (X-XSS-Protection retiré : obsolète, plus aucun navigateur récent ne
    # l'utilise — la CSP ci-dessous est la vraie protection contre les XSS)

    # Ne transmet pas le referrer vers d'autres domaines
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Politique de sécurité du contenu (CSP)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data:;"
</IfModule>

# Forcer HTTPS : inutile sur GitHub Pages (deja fait par la plateforme),
# mais a decommenter si le site est un jour heberge ailleurs (ex. IONOS)
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# Bloquer l'accès direct aux fichiers sensibles
<FilesMatch "^(config\.php|composer\.(json|lock)|\.env)$">
    Order allow,deny
    Deny from all
</FilesMatch>
